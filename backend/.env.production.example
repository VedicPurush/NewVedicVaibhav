# ══════════════════════════════════════════════════════════════════════════════
#  PRODUCTION / LIVE environment — loaded when NODE_ENV=production.
#
#  Everything here is LIVE: real customer databases, real money, real emails.
#  Never point a local machine at this file unless you mean it.
#
#  Every key below is read by src/config/env.ts. Blanks are secrets;
#  pre-filled values are non-secret defaults. Keep this in sync when adding keys.
#
#  Template — copy to .env.production and fill in the blanks.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5009

# ── MongoDB — LIVE cluster ────────────────────────────────────────────────────
# Same key names as .env.development; the file that gets loaded decides which
# cluster you talk to. No TESTING_ prefix, no switch in code.
MONGO_URI_VEDIC_VAIBHAV_MAIN=
MONGO_URI_JYOTIRLING=
MONGO_URI_PARTNER_AFFILIATE=

# ── Auth ──────────────────────────────────────────────────────────────────────
# ⚠️ Changing this invalidates every token already issued to users/app clients.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Razorpay — LIVE keys (the only payment gateway) ───────────────────────────
PAYMENT_MODE=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# ⚠️ Webhook secrets were commented out in the old .env, i.e. unset — webhook
# signature verification cannot pass until these are filled in.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_4DHAM_WEBHOOK_SECRET=
RAZORPAY_BB_WEBHOOK_SECRET=
RAZORPAY_GAUSEVA_WEBHOOK_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ADMIN_MAIL=

# ── SMS / OTP (Fast2SMS) ──────────────────────────────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ── WhatsApp (Pinbot) ─────────────────────────────────────────────────────────
PINBOT_API_KEY=
PINBOT_PHONE_NUMBER_ID=

# ── Twilio (SMS OTP) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Meta Conversions API ──────────────────────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_DEFAULT_EVENT_SOURCE_URL=https://vedicvaibhav.com
# Must stay EMPTY in production — a test code diverts events to the test panel.
META_TEST_EVENT_CODE=

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_DEFAULT_PICKUP_POSTCODE=

# ── Partner affiliate ─────────────────────────────────────────────────────────
PARTNER_AFFILIATE_BASE_URL=https://partner.vedicvaibhav.in
PARTNER_AFFILIATE_ORDER_API=https://partner.vedicvaibhav.in/api/external/orders
EXTERNAL_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── International pricing / FX ────────────────────────────────────────────────
# ALL OPTIONAL. Every one has a committed default in src/config/pricing.ts —
# these exist so a rate or a price can be hotfixed WITHOUT A DEPLOY.
#
# A bad value here can never stop the site taking payments: it is logged as a
# warning and the committed default is kept. The accepted ranges are typo guards
# (a bare "3" meaning "3%" would otherwise be a 300% markup on real customers).
#
#   FX_RATES        "USD:90,GBP:118"  INR per unit, for the listed currencies only
#   FX_BUFFER       "1.04"            margin over the raw rate. Range 1.00-1.25
#   FX_MULTIPLIER   "2"               one flat foreign markup; turns the ladder OFF
#   FX_MULTIPLIERS  "USD:2.5,NPR:1"   per-currency; beats both the flat value and the ladder
#   FX_TIERS        "100:4,150:3,*:2" replace the whole markup ladder. "*" = Infinity
FX_RATES=
FX_BUFFER=
FX_MULTIPLIER=
FX_MULTIPLIERS=
FX_TIERS=

# ── Geo-IP ────────────────────────────────────────────────────────────────────
# Resolves the caller's country so the browser's timezone guess (a property of
# the DEVICE) can be corrected by their actual connection. Both optional; edge
# headers (cf-ipcountry etc.) are tried first and are free, then two keyless
# fallbacks. See src/utils/geoip.ts.
#
#   GEOIP_URL   your own provider, e.g. https://ipinfo.io/{ip}/json?token=...
GEOIP_URL=

# GEOIP_DEV_COUNTRY is a dev-only override and is deliberately absent here: it is
# only consulted for a private/loopback client IP, so it could not affect a real
# visitor anyway, but there is no reason for it to be set in production.
