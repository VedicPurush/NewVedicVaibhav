# ══════════════════════════════════════════════════════════════════════════════
#  DEVELOPMENT / TESTING environment — loaded when NODE_ENV=development.
#
#  Everything here points at TEST infrastructure: the testing Mongo cluster,
#  Razorpay test keys, the Meta test-event panel.
#  Nothing in this file should ever touch live customer data.
#
#  Every key below is read by src/config/env.ts. Blanks are secrets;
#  pre-filled values are non-secret defaults. Keep this in sync when adding keys.
#
#  Template — copy to .env.development and fill in the blanks.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5009

# ── MongoDB — TESTING cluster ─────────────────────────────────────────────────
# Same key names as .env.production; the file that gets loaded decides which
# cluster you talk to. No TESTING_ prefix, no switch in code.
MONGO_URI_VEDIC_VAIBHAV_MAIN=
MONGO_URI_JYOTIRLING=
MONGO_URI_PARTNER_AFFILIATE=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Same secret as production so a token minted here still verifies there.
# Safe to change to a dev-only value if you don't need that.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Razorpay — TEST keys (the only payment gateway) ───────────────────────────
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secrets were commented out in the old .env, i.e. unset. Fill these in
# to make webhook signature verification actually pass.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_4DHAM_WEBHOOK_SECRET=
RAZORPAY_BB_WEBHOOK_SECRET=
RAZORPAY_GAUSEVA_WEBHOOK_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ADMIN_MAIL=

# ── SMS / OTP (Fast2SMS) ──────────────────────────────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# ── WhatsApp (Pinbot) ─────────────────────────────────────────────────────────
PINBOT_API_KEY=
PINBOT_PHONE_NUMBER_ID=

# ── Twilio (SMS OTP) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Meta Conversions API ──────────────────────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_DEFAULT_EVENT_SOURCE_URL=http://localhost:3000
# Routes dev events to the Meta Test Events panel instead of live reporting.
META_TEST_EVENT_CODE=

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_DEFAULT_PICKUP_POSTCODE=

# ── Partner affiliate ─────────────────────────────────────────────────────────
# Dev always resolves to http://localhost:9001 (see config/env.ts); these are
# only read in production.
PARTNER_AFFILIATE_BASE_URL=
PARTNER_AFFILIATE_ORDER_API=
EXTERNAL_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ── International pricing / FX ────────────────────────────────────────────────
# ALL OPTIONAL. Every one has a committed default in src/config/pricing.ts —
# these exist so a rate or a price can be hotfixed WITHOUT A DEPLOY.
#
# A bad value here can never stop the site taking payments: it is logged as a
# warning and the committed default is kept. The accepted ranges are typo guards
# (a bare "3" meaning "3%" would otherwise be a 300% markup on real customers).
#
#   FX_RATES        "USD:90,GBP:118"  INR per unit, for the listed currencies only
#   FX_BUFFER       "1.04"            margin over the raw rate. Range 1.00-1.25
#   FX_MULTIPLIER   "2"               one flat foreign markup; turns the ladder OFF
#   FX_MULTIPLIERS  "USD:2.5,NPR:1"   per-currency; beats both the flat value and the ladder
#   FX_TIERS        "100:4,150:3,*:2" replace the whole markup ladder. "*" = Infinity
FX_RATES=
FX_BUFFER=
FX_MULTIPLIER=
FX_MULTIPLIERS=
FX_TIERS=

# ── Geo-IP ────────────────────────────────────────────────────────────────────
# Resolves the caller's country so the browser's timezone guess (a property of
# the DEVICE) can be corrected by their actual connection. Both optional; edge
# headers (cf-ipcountry etc.) are tried first and are free, then two keyless
# fallbacks. See src/utils/geoip.ts.
#
#   GEOIP_URL   your own provider, e.g. https://ipinfo.io/{ip}/json?token=...
GEOIP_URL=

# Localhost cannot be geolocated (::1), so the whole flow is untestable in dev.
#   GEOIP_DEV_COUNTRY=DE     force a country
#   GEOIP_DEV_COUNTRY=auto   geolocate THIS MACHINE's egress (follows a system-wide VPN)
# Only ever consulted for a PRIVATE client IP, so it cannot affect a real visitor.
GEOIP_DEV_COUNTRY=
