# ══════════════════════════════════════════════════════════════════════════════
#  Template for .env — copy to .env.
#
#  .env holds ONE thing: which mode the backend runs in. Every credential lives
#  in the mode file that gets loaded:
#
#    NODE_ENV=development  ->  .env.development  (copy .env.development.example)
#    NODE_ENV=production   ->  .env.production   (copy .env.production.example)
#
#  See "Environment system" in README.md.
# ══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
